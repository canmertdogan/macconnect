<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="#09090B">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MacConnect"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bluetooth Bridge"
                android:textColor="#71717A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Status Pill -->
        <LinearLayout
            android:id="@+id/layout_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <View
                android:id="@+id/view_header_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#EF4444"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tv_header_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bağlantı Yok"
                android:textColor="#A1A1AA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Segmented Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_tab_container"
            android:padding="3dp">

            <Button
                android:id="@+id/btn_tab_tools"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⚡ Araçlar"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_tab_selected" />

            <Button
                android:id="@+id/btn_tab_history"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="📬 Bildirimler"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#71717A"
                android:background="@drawable/bg_tab_unselected" />

            <Button
                android:id="@+id/btn_tab_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⚙️ Pil &amp; Ayarlar"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#71717A"
                android:background="@drawable/bg_tab_unselected" />
        </LinearLayout>
    </LinearLayout>

    <!-- TAB 1: TOOLS & CONNECTION -->
    <ScrollView
        android:id="@+id/layout_tab_tools"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Hero Connection Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/view_status_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#EF4444"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tv_status_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bağlantı Bekleniyor"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_battery_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="🔋 --%"
                        android:textColor="#10B981"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_status_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mac'ten Bluetooth bağlantısı bekleniyor..."
                    android:textColor="#A1A1AA"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Eşleşen Mac Cihazı:"
                    android:textColor="#71717A"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinner_devices"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_edittext"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_connect"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="Mac'e Bağlan"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_btn_primary"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Yenile"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_btn_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Text & Clipboard Sharing Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mac'e Metin / Pano Gönder"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Yazılan metin veya link Mac'in panosuna anında aktarılır."
                    android:textColor="#71717A"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_share_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:maxLines="6"
                    android:gravity="top|start"
                    android:background="@drawable/bg_edittext"
                    android:padding="12dp"
                    android:hint="Mac'e göndermek istediğiniz metni veya notu yazın..."
                    android:textColorHint="#52525B"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_paste_clipboard"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="📋 Panodan Yapıştır"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_btn_secondary"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_send_text"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="📤 Mac'e Gönder"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_btn_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- File Transfer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mac'e Dosya Gönder"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fotoğraf, video veya belgeleri Mac İndirilenler klasörüne aktarır."
                    android:textColor="#71717A"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_choose_file"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="📂 Dosya Seç ve Gönder"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_secondary" />

                <TextView
                    android:id="@+id/tv_file_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Henüz dosya seçilmedi"
                    android:textColor="#71717A"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

                <ProgressBar
                    android:id="@+id/progressbar_file"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="0"
                    android:visibility="gone"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Diagnostics Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tanılama &amp; Loglar"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_test_notif"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Test Bildirimi"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_btn_secondary"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_show_logs"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Geliştirici Logları"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_btn_secondary" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- TAB 2: NOTIFICATION FEED -->
    <LinearLayout
        android:id="@+id/layout_tab_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_history_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bildirim Geçmişi (0)"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Temizle"
                android:textSize="11sp"
                android:textColor="#EF4444"
                android:background="@drawable/bg_btn_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_history_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Henüz kaydedilmiş bildirim yok.\nTelefona gelen bildirimler burada listelenecek ve Mac'e aktarılacaktır."
            android:textColor="#71717A"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="visible" />

        <ListView
            android:id="@+id/lv_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- TAB 3: BATTERY & SETTINGS -->
    <ScrollView
        android:id="@+id/layout_tab_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Battery Optimization Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pil Optimizasyonu &amp; Doze"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_battery_opt_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="Korumalı ✅"
                        android:textColor="#10B981"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MacConnect ekran kapalıyken bile arka planda kesintisiz çalışır. Bluetooth RFCOMM donanım seviyesinde dinlenir ve CPU uyku modunda kalarak sıfıra yakın (&lt;%0.1) pil tüketir."
                    android:textColor="#A1A1AA"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_battery_opt"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="Pil Tasarrufundan Muaf Tut (Önerilen)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_primary" />
            </LinearLayout>

            <!-- Permissions Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sistem İzinleri"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Notification Access Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_notif_perm_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bildirim Erişimi"
                        android:textColor="#E4E4E7"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_grant_notif"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="İzin Ver"
                        android:textSize="12sp"
                        android:background="@drawable/bg_btn_primary"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Bluetooth Permission Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_bt_perm_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bluetooth İzni"
                        android:textColor="#E4E4E7"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_grant_bt"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="İzin Ver"
                        android:textSize="12sp"
                        android:background="@drawable/bg_btn_primary"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Phone Call Answering Permission Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_call_perm_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Arama Yanıtlama İzni"
                        android:textColor="#E4E4E7"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_grant_call"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="İzin Ver"
                        android:textSize="12sp"
                        android:background="@drawable/bg_btn_primary"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Xiaomi / MIUI Background Guide Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Redmi / Xiaomi / MIUI Arka Plan Rehberi"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MIUI / HyperOS arka planda çalışan servisleri agresif şekilde sonlandırabilir. Kesintisiz bağlantı için:"
                    android:textColor="#A1A1AA"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Otomatik Başlatma (Autostart) iznini açık tutun.\n2. Pil Tasarrufu ayarını 'Kısıtlama Yok' yapın.\n3. Son Uygulamalar ekranında MacConnect kartını aşağı çekip kilitleyin."
                    android:textColor="#71717A"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_battery_settings"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Uygulama Bilgisi / Ayarları Aç"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_secondary" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
