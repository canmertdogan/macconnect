<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:background="#161618">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MacConnect"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/view_header_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="#FF3B30"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tv_header_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bağlantı Yok"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top Navigation Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#161618">

        <Button
            android:id="@+id/btn_tab_tools"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Bağlantı &amp; Araçlar"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tab_selected"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_tab_history"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Bildirim Geçmişi"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#A0A0A5"
            android:background="@drawable/bg_tab_unselected"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_tab_settings"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Ayarlar"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#A0A0A5"
            android:background="@drawable/bg_tab_unselected" />
    </LinearLayout>

    <!-- TAB 1: TOOLS & CONNECTION -->
    <ScrollView
        android:id="@+id/layout_tab_tools"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Connection Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/view_status_dot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="#FF3B30"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tv_status_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bağlantı Kesildi"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_status_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mac'ten Bluetooth bağlantısı bekleniyor..."
                    android:textColor="#A0A0A5"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Eşleşen Mac Cihazı:"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinner_devices"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_edittext"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_connect"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Mac'e Bağlan"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#007AFF"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Yenile"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2C2C2E" />
                </LinearLayout>
            </LinearLayout>

            <!-- Send Text / Clipboard Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mac'e Metin / Pano Gönder"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gönderdiğiniz metin Mac panosuna doğrudan kopyalanır."
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/et_share_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:maxLines="6"
                    android:gravity="top|start"
                    android:background="@drawable/bg_edittext"
                    android:padding="10dp"
                    android:hint="Mac'e göndermek istediğiniz metni veya notu yazın..."
                    android:textColorHint="#636366"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_paste_clipboard"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Panodan Yapıştır"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2C2C2E"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_send_text"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Mac'e Gönder"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#34C759" />
                </LinearLayout>
            </LinearLayout>

            <!-- Send File Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mac'e Dosya Gönder"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fotoğraf veya belgeleri Mac İndirilenler klasörüne aktarır."
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_choose_file"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Dosya Seç ve Mac'e Gönder"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#007AFF" />

                <TextView
                    android:id="@+id/tv_file_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Henüz dosya seçilmedi"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

                <ProgressBar
                    android:id="@+id/progressbar_file"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:visibility="gone"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Diagnostics & Logs Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hızlı Tanılama &amp; Loglar"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_test_notif"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Test Bildirimi"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#34C759"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_show_logs"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Logları İncele"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2C2C2E" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- TAB 2: NOTIFICATION HISTORY -->
    <LinearLayout
        android:id="@+id/layout_tab_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_history_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bildirim Geçmişi (0)"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Geçmişi Temizle"
                android:textSize="11sp"
                android:textColor="#FF453A"
                android:backgroundTint="#2C2C2E" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_history_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Henüz kaydedilmiş bildirim yok.\nTelefona gelen bildirimler burada listelenecek ve Mac'e aktarılacaktır."
            android:textColor="#8E8E93"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="30dp"
            android:visibility="visible" />

        <ListView
            android:id="@+id/lv_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- TAB 3: SETTINGS & PERMISSIONS -->
    <ScrollView
        android:id="@+id/layout_tab_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Permissions Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gerekli İzinler"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Notification Access Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_notif_perm_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bildirim Erişimi"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_grant_notif"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="İzin Ver"
                        android:textSize="12sp"
                        android:backgroundTint="#007AFF"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Bluetooth Permission Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_bt_perm_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bluetooth İzni"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_grant_bt"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="İzin Ver"
                        android:textSize="12sp"
                        android:backgroundTint="#007AFF"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Xiaomi / MIUI Background Optimization Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Redmi / Xiaomi Arka Plan Rehberi"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MIUI / HyperOS arka planda çalışan servisleri kapatabilir. Kesintisiz bağlantı için:"
                    android:textColor="#C7C7CC"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Otomatik Başlatma (Autostart) iznini açın.\n2. Pil Tasarrufu ayarını 'Kısıtlama Yok' (No restrictions) yapın.\n3. Son Uygulamalar ekranında MacConnect kartını aşağı çekip kilitleyin."
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_battery_settings"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="Uygulama Bilgisi / Pil Ayarları"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
