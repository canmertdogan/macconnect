<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <!-- Header: App Icon & Name & Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/iv_detail_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="12dp"
            android:contentDescription="App Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_detail_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Application Name"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oct 6, 2026, 2:00 PM"
                android:textColor="#A1A1AA"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_detail_package"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="com.example.app"
        android:textColor="#71717A"
        android:textSize="11sp"
        android:layout_marginBottom="12dp" />

    <!-- Separator Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#27272A"
        android:layout_marginBottom="14dp" />

    <!-- Content Area in ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="320dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notification Title"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textIsSelectable="true"
                android:layout_marginBottom="6dp" />

            <!-- Subtitle / Meta -->
            <TextView
                android:id="@+id/tv_detail_subtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:textIsSelectable="true"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- Body Message -->
            <TextView
                android:id="@+id/tv_detail_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full notification text is shown here."
                android:textColor="#F4F4F5"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_detail_copy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📋 Copy Text"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_detail_close"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Close"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="@drawable/bg_btn_secondary"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>

</LinearLayout>
